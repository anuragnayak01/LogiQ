# --- Postgres (your existing instance) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM provider: "claude" or "openai" ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embeddings (always OpenAI, regardless of LLM_PROVIDER) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Retrieval tuning ---
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- CORS: your deployed frontend origin(s), comma-separated ---
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Admin routes: required X-Admin-Key header value. Set to a random string. ---
ADMIN_API_KEY=change-me-to-something-random
