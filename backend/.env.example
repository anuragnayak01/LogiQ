# --- Postgres (free tier: Neon, Supabase, or Render Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM provider: "groq" (free), "claude", or "openai" ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embeddings: "fastembed" (free, local, default) or "openai" (paid, higher quality) ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# If EMBEDDING_PROVIDER=openai, use instead:
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Retrieval tuning ---
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- CORS: your deployed frontend origin(s), comma-separated ---
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Admin routes: required X-Admin-Key header value. Set to a random string. ---
ADMIN_API_KEY=change-me-to-something-random
